AEGIS_ENV=development
AEGIS_CONFIG_PATH=configs/config.example.yaml
AEGIS_HTTP_ADDR=:8080
AEGIS_READ_TIMEOUT=10s
AEGIS_WRITE_TIMEOUT=15s
AEGIS_IDLE_TIMEOUT=60s
AEGIS_SHUTDOWN_TIMEOUT=10s
# Redis ACL credentials are optional. Set them only in an ignored local .env.
# AEGIS_REDIS_USERNAME=
# AEGIS_REDIS_PASSWORD=
